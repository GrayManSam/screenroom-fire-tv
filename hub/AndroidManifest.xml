<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.geekedsilicon.tvhub" android:versionCode="8" android:versionName="1.6">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries>
        <package android:name="com.movieboxpro.androidtv" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="com.amazon.firetv.youtube" />
    </queries>
    <application android:label="Screenroom" android:banner="@drawable/banner"
        android:icon="@drawable/banner" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:allowBackup="false">
        <activity android:name=".HubActivity" android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
